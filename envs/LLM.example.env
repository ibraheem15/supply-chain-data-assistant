# Which provider the agent uses: gemini (default) or groq. Override per run with --provider.
LLM_PROVIDER=gemini

# Gemini LLM API configuration
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_PROJECT_ID=replace-with-your-gcp-project-id
GEMINI_MODEL=replace-with-your-gemini-model-name

# Groq LLM API configuration
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=replace-with-your-groq-model-name
